{
  "name": "javatb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An interactive, reference-grade Java textbook.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "node --experimental-strip-types server/standalone.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run verify:snippets && npm run verify:problems",
    "verify:snippets": "node --no-warnings --experimental-strip-types scripts/verify-snippets.ts",
    "verify:problems": "node --no-warnings --experimental-strip-types scripts/verify-exercises.ts"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "playwright": "^1.63.0",
    "shiki": "^1.24.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
